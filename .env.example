# Public Supabase project values (safe to expose in the browser bundle).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix these with NEXT_PUBLIC_ and never commit real values.
SUPABASE_SERVICE_ROLE_KEY=
UGAVOLE_EDITOR_ACTOR_ID=
EDITORIAL_IMPORT_CONFIRM=
UGC_RATE_LIMIT_SECRET=
UGC_SUBMISSIONS_ENABLED=false
TRUST_CLOUDFLARE_IP_HEADER=false
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=ugavole.com
SOCIAL_CRON_SECRET=
RETENTION_CRON_SECRET=
EDITORIAL_CRON_SECRET=
UGAVOLE_SITE_URL=https://ugavole.com
APP_ORIGIN=http://localhost:3000

# RSS-derived editorial drafts are private and stay in the moderation queue.
# Source article bodies and images are never fetched by this worker.
UGAVOLE_EDITORIAL_DRAFTS_ENABLED=false
GEMINI_API_KEY=
UGAVOLE_EDITORIAL_MODEL=gemini-3.1-flash-lite

# Public mirror of the server gate plus the non-secret Cloudflare widget key.
NEXT_PUBLIC_UGC_SUBMISSIONS_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Analytics/ads remain fail-closed until consent and the certified CMP are ready.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT_ID=ca-pub-7117498587512923
NEXT_PUBLIC_GOOGLE_ADSENSE_SLOT=
NEXT_PUBLIC_GOOGLE_CERTIFIED_CMP_READY=false

# Public links appear only after you have verified ownership of each account.
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/ugavole
NEXT_PUBLIC_FACEBOOK_HANDLE=UGavole
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_INSTAGRAM_HANDLE=
NEXT_PUBLIC_X_URL=https://x.com/ugavole
NEXT_PUBLIC_X_HANDLE=@uGavole
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_YOUTUBE_HANDLE=

# Social worker and adapters are disabled unless explicitly enabled and complete.
UGAVOLE_SOCIAL_WORKER_ENABLED=false
SOCIAL_MEDIA_ALLOWED_HOSTS=ugavole.com
INSTAGRAM_IMMUTABLE_MEDIA_HOSTS=

UGAVOLE_FACEBOOK_ENABLED=false
META_PAGE_ID=
META_PAGE_HANDLE=UGavole
META_PAGE_ACCESS_TOKEN=
META_GRAPH_API_VERSION=
META_ACCESS_TOKEN_EXPIRES_AT=

UGAVOLE_INSTAGRAM_ENABLED=false
META_INSTAGRAM_ACCOUNT_ID=
META_INSTAGRAM_HANDLE=
META_INSTAGRAM_ACCESS_TOKEN=

UGAVOLE_X_ENABLED=false
X_API_USER_ID=
X_DISPLAY_HANDLE=@uGavole
X_USER_ACCESS_TOKEN=
X_USER_ACCESS_TOKEN_EXPIRES_AT=
X_API_MONTHLY_POST_CAP=
X_API_COST_NOTICE=

# Only needed for the one-time legacy importer, never by the app runtime.
LEGACY_WP_API_URL=
